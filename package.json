{
  "name": "questmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/questmark next build && NEXT_PUBLIC_BASE_PATH=/questmark node scripts/build-service-worker.mjs",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types src/app/skill-map-model.self-test.ts && node --experimental-strip-types src/app/quest-recommendations.self-test.ts",
    "test:e2e": "npm run build:pages && npm run test:pages",
    "test:pages": "node scripts/test-pages.mjs",
    "capture": "node scripts/capture-portfolio.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
